<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Both are asked for at runtime, from the settings screen; the modules that need them
         show a placeholder until then. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Not to draw anything: it's the only background-activity-start exemption this app can
         reach. The panel window hangs off the launcher's activity token, so the system counts
         it as the launcher's window, and tapping a card would otherwise be dropped with
         BAL_BLOCK. Granted from the settings screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="HTML Feed"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The launcher binds to this service to show the -1 screen. -->
        <service
            android:name=".OverlayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
                <action android:name="com.google.android.apps.gsa.sidekick.SidekickService" />
                <data android:scheme="app" />
            </intent-filter>
            <meta-data
                android:name="service.api.version"
                android:value="7" />
        </service>
    </application>
</manifest>
