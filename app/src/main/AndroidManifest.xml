<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather. The forecast is for wherever the phone is, so the module needs a fix; coarse
         is a forecast's resolution anyway. Asked for at runtime like the two below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The panel is a service the launcher binds, so this app never counts as on screen while
         it's open and a foreground-only grant has every read rejected by appops. Without this
         the weather card can only show the fix the settings screen last stored. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Both are asked for at runtime, from the settings screen; the modules that need them
         show a placeholder until then. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Not to draw anything: it's the only background-activity-start exemption this app can
         reach. The panel window hangs off the launcher's activity token, so the system counts
         it as the launcher's window, and tapping a card would otherwise be dropped with
         BAL_BLOCK. Granted from the settings screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility: without these, resolveActivity for a maps app always comes back
         null on Android 11+ and every destination would fall back to the generic map pin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Pixel Weather, which a tap on the weather card opens. Named outright because it's
             looked up by package rather than resolved from an intent. -->
        <package android:name="com.google.android.apps.weather" />
    </queries>

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="HTML Feed"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen widgets. One per module that can stand on its own: the clock and
             the weather have none, and the web page can't have one. See HubWidgets. -->
        <receiver
            android:name=".widget.ContactsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_contacts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_contacts_info" />
        </receiver>

        <receiver
            android:name=".widget.NavigationWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_navigation_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_navigation_info" />
        </receiver>

        <receiver
            android:name=".widget.AgendaWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- The clock being set moves every "Today" and "Tomorrow" on the widget. Both of
                 these are still delivered to a manifest receiver on Android 8 and up. -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <!-- And an edit in the calendar changes the list itself. -->
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>

        <!-- The launcher binds to this service to show the -1 screen. -->
        <service
            android:name=".OverlayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
                <action android:name="com.google.android.apps.gsa.sidekick.SidekickService" />
                <data android:scheme="app" />
            </intent-filter>
            <meta-data
                android:name="service.api.version"
                android:value="7" />
        </service>
    </application>
</manifest>
